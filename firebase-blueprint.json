{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "Student assignment, deadline, or calendar event synced across platforms.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["todo", "in_progress", "completed"] },
        "source": {
          "type": "string",
          "enum": ["moodle", "google_classroom", "google_calendar", "notion", "trello", "personal"]
        },
        "course": { "type": "string" },
        "dueDate": { "type": "string" },
        "description": { "type": "string" },
        "gcalEventId": { "type": "string" }
      },
      "required": ["id", "uid", "title", "priority", "status", "source", "dueDate"]
    },
    "MoodleCourse": {
      "title": "MoodleCourse",
      "description": "Enrolled Moodle course configuration and module assignments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "synced": { "type": "boolean" }
      },
      "required": ["id", "uid", "code", "name", "synced"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User theme and connected platform preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "theme": { "type": "string", "enum": ["light", "dark", "system"] }
      },
      "required": ["uid", "theme"]
    }
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User tasks and synced deadlines"
    },
    "/users/{userId}/moodle_courses/{courseId}": {
      "schema": { "$ref": "#/entities/MoodleCourse" },
      "description": "User Moodle courses"
    },
    "/users/{userId}/settings/{docId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User settings and appearance preferences"
    }
  }
}
